# LLM API Configuration (any OpenAI-compatible endpoint)
LLM_API_URL=http://localhost:8080/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-20250514

# Unsplash API (optional, for Midnight Postcard)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Spotify API (for Music Rec + Monthly Playlist generators)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Discord cross-posting (optional)
NOOSPHERE_DISCORD_CHANNEL=your-discord-channel-id
DISCORD_BOT_TOKEN=your-discord-bot-token
